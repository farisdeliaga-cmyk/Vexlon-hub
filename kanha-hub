        espTick = espTick + 1
        if espTick % 20 ~= 0 then return end
        for _, v in ipairs(espFolder:GetChildren()) do v:Destroy() end
        for _, p in ipairs(P:GetPlayers()) do
            if p ~= LP and p.Character then
                local role = getRole(p)
                local show = false
                if role == "Murderer" and espFlags.murderer then show = true
                elseif role == "Sheriff" and espFlags.sheriff then show = true
                elseif role == "Innocent" and espFlags.innocent then show = true end
                if show then
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local bb = Instance.new("BillboardGui", espFolder) bb.Adornee = hrp bb.Size = UDim2.new(0,120,0,25) bb.AlwaysOnTop = true
                        local tl = Instance.new("TextLabel", bb) tl.Size = UDim2.new(1,1,1,1) tl.BackgroundTransparency = 1 tl.Text = p.Name.." ["..role.."]" tl.TextColor3 = espColors[role:lower()] or Color3.new(1,1,1) tl.TextScaled = true tl.TextStrokeTransparency = 0
                    end
                end
            end
        end
        if espFlags.coin or espFlags.gun or espFlags.knife then
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") then
                    local n = obj.Name:lower() local key = nil
                    if espFlags.coin and n:find("coin") then key = "coin"
                    elseif espFlags.gun and (n:find("gun") or n:find("revolver")) then key = "gun"
                    elseif espFlags.knife and n:find("knife") then key = "knife" end
                    if key then
                        local bb = Instance.new("BillboardGui", espFolder) bb.Adornee = obj bb.Size = UDim2.new(0,80,0,20) bb.AlwaysOnTop = true
                        local tl = Instance.new("TextLabel", bb) tl.Size = UDim2.new(1,1,1,1) tl.BackgroundTransparency = 1 tl.Text = obj.Name tl.TextColor3 = espColors[key] tl.TextScaled = true tl.TextStrokeTransparency = 0
                    end
                end
            end
        end
    end))
    tab:CreateSection("Sistem")
    b.addCommonButtons(tab)
    b.notify("MM2", "Yuklendi", 3)
end

