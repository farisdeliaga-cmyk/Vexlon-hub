                    local tl = Instance.new("TextLabel", bb) tl.Size = UDim2.new(1,1,1,1) tl.BackgroundTransparency = 1 tl.Text = obj.Name tl.TextColor3 = espColors[key] tl.TextScaled = true tl.TextStrokeTransparency = 0
