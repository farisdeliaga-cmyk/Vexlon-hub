        local hrp = LP.Character:FindFirstChild("HumanoidRootPart") if not hrp then return end
        for _, obj in ipairs(workspace:GetDescendants()) do
            if isEntity(obj.Name) then
                local p = obj:IsA("BasePart") and obj or (obj:IsA("Model") and obj.PrimaryPart)
                if p and (p.Position - hrp.Position).Magnitude < 40 then
                    for _, loc in ipairs(workspace:GetDescendants()) do
                        if loc.Name:lower():find("locker") or loc.Name:lower():find("closet") then
                            local lp = loc:IsA("BasePart") and loc or (loc:IsA("Model") and loc.PrimaryPart)
