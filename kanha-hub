-- ============ SHIM ============
local function httpGet(url)
    if syn and syn.request then local ok, r = pcall(function() return syn.request({Url=url, Method="GET"}).Body end) if ok and r then return r end end
    if fluxus and fluxus.request then local ok, r = pcall(function() return fluxus.request({Url=url, Method="GET"}).Body end) if ok and r then return r end end
    if http_request then local ok, r = pcall(function() return http_request({Url=url, Method="GET"}).Body end) if ok and r then return r end end
    if http and http.request then local ok, r = pcall(function() return http.request({Url=url, Method="GET"}).Body end) if ok and r then return r end end
    return game:HttpGet(url)
end
local function writeFile(n, d) if writefile then pcall(writefile, n, d) return true end if syn and syn.write_file then pcall(syn.write_file, n, d) return true end return false end
local function readFile(n) if readfile then local ok, d = pcall(readfile, n) if ok then return d end end if syn and syn.read_file then local ok, d = pcall(syn.read_file, n) if ok then return d end end return nil end
local function isFile(n) if isfile then return isfile(n) end if syn and syn.is_file then return syn.is_file(n) end return false end
local function delFile(n) if delfile then pcall(delfile, n) return true end if syn and syn.delete_file then pcall(syn.delete_file, n) return true end return false end

-- FIX: fireproximityprompt shim
local function firePrompt(pp)
    if type(fireproximityprompt) == "function" then pcall(fireproximityprompt, pp) return true end
    if syn and syn.fireproximityprompt then pcall(syn.fireproximityprompt, pp) return true end
    pcall(function() pp:InputHoldBegin() task.wait(0.5) pp:InputHoldEnd() end)
    return false
end

