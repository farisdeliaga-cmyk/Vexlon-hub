function base.pressKey(key, delay)
    task.spawn(function()
        base.VIM:SendKeyEvent(true, key, false, game)
        task.wait(delay or 0.1)
        base.VIM:SendKeyEvent(false, key, false, game)
    end)
end
function base.clickMouse(delay)
    task.spawn(function()
        local c = workspace.CurrentCamera.ViewportSize
        base.VIM:SendMouseButtonEvent(c.X/2, c.Y/2, 0, true, game, 0)
        task.wait(delay or 0.1)
        base.VIM:SendMouseButtonEvent(c.X/2, c.Y/2, 0, false, game, 0)
    end)
end
function base.notify(title, content, duration)
    pcall(function() Rayfield:Notify({Title=title, Content=content, Duration=duration or 4, Image=4483362458}) end)
end
function base.track(name, conn)
    if base.connections[name] then pcall(function() base.connections[name]:Disconnect() end) end
    base.connections[name] = conn
end
function base.untrack(name)
    if base.connections[name] then pcall(function() base.connections[name]:Disconnect() end) base.connections[name] = nil end
end
function base.trackChild(name, conn)
    if base.childConnections[name] then pcall(function() base.childConnections[name]:Disconnect() end) end
    base.childConnections[name] = conn
end
function base.untrackChild(name)
    if base.childConnections[name] then pcall(function() base.childConnections[name]:Disconnect() end) base.childConnections[name] = nil end
end
function base.unload()
    for _, c in pairs(base.connections) do pcall(function() c:Disconnect() end) end
    for _, c in pairs(base.childConnections) do pcall(function() c:Disconnect() end) end
    base.connections = {} base.childConnections = {}
    pcall(function() Rayfield:Destroy() end)
end
