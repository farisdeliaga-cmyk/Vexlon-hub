local function LoadSkillESP(b)
    local tab = b.Window:CreateTab("Skill ESP", 4483362458)
    local active = false
    local skillGui = Instance.new("ScreenGui", game.CoreGui) skillGui.Name = "KanhaSkillESP" skillGui.ResetOnSpawn = false
    local skillFolder = Instance.new("Folder", skillGui)
    local lastSkills = {}
    local function attach(p)
        if not p.Character then return end
        local hum = p.Character:FindFirstChildOfClass("Humanoid")
        local anim = hum and hum:FindFirstChildOfClass("Animator")
        if not anim then return end
        anim.AnimationPlayed:Connect(function(tr)
            if not active then return end
            local n = tr.Animation and tr.Animation.Name or ""
            if n == "" then return end
            lastSkills[p.Name] = {text=n, time=tick()}
        end)
    end
    b.trackChild("skill_pa", b.Players.PlayerAdded:Connect(function(p) p.CharacterAdded:Connect(function() task.wait(1) attach(p) end) end))
    b.trackChild("skill_pr", b.Players.PlayerRemoving:Connect(function(p) lastSkills[p.Name] = nil end))
    for _, p in ipairs(b.Players:GetPlayers()) do if p ~= b.LP and p.Character then task.spawn(function() task.wait(1) attach(p) end) end end
    tab:CreateToggle({Name="Skill Name ESP", CurrentValue=false, Callback=function(s) active = s end})
    b.track("skill_esp", b.RunService.RenderStepped:Connect(function()
        if not active then return end
        for _, v in ipairs(skillFolder:GetChildren()) do v:Destroy() end
        for name, data in pairs(lastSkills) do
            if (tick() - data.time) < 3 then
                local p = b.Players:FindFirstChild(name)
                if p and p.Character then
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local bb = Instance.new("BillboardGui", skillFolder) bb.Adornee = hrp bb.Size = UDim2.new(0,150,0,25) bb.StudsOffset = Vector3.new(0,4,0) bb.AlwaysOnTop = true
                        local tl = Instance.new("TextLabel", bb) tl.Size = UDim2.new(1,1,1,1) tl.BackgroundTransparency = 0.5 tl.BackgroundColor3 = Color3.fromRGB(20,20,20) tl.Text = data.text tl.TextColor3 = Color3.fromRGB(255,200,100) tl.TextScaled = true tl.TextStrokeTransparency = 0
                    end
                end
            end
        end
    end))
end
local function LoadAutoBlock(b)
    local tab = b.Window:CreateTab("Perfect Block", 4483362458)
    local active, blockKey, range = false, Enum.KeyCode.F, 15
    local blockCd = 0
    tab:CreateSlider({Name="Range", Range={5,30}, Increment=1, CurrentValue=15, Callback=function(v) range = v end})
    tab:CreateInput({Name="Block Key", PlaceholderText="F", RemoveTextAfterFocusLost=false, Callback=function(v) local k = Enum.KeyCode[v:upper()] if k then blockKey = k end end})
    tab:CreateToggle({Name="Auto Perfect Block", CurrentValue=false, Callback=function(s) active = s end})
    b.track("perfect_block", b.RunService.Heartbeat:Connect(function(dt)
        if not active or not b.LP.Character then return end
        blockCd = blockCd - dt if blockCd > 0 then return end
        blockCd = 0.05
        local lhrp = b.LP.Character:FindFirstChild("HumanoidRootPart") if not lhrp then return end
        for _, p in ipairs(b.Players:GetPlayers()) do
            if p ~= b.LP and p.Character then
                local phrp = p.Character:FindFirstChild("HumanoidRootPart")
                if phrp and (phrp.Position - lhrp.Position).Magnitude <= range then
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    local anim = hum and hum:FindFirstChildOfClass("Animator")
                    if anim then
                        for _, track in ipairs(anim:GetPlayingAnimationTracks()) do
                            local n = track.Animation and track.Animation.Name or ""
                            if n ~= "" and (n:lower():find("punch") or n:lower():find("kick") or n:lower():find("attack") or n:lower():find("m1")) then
                                if track.TimePosition > 0.05 and track.TimePosition < 0.15 then
                                    b.pressKey(blockKey, 0.1)
                                    blockCd = 0.2
                                    break
                                end
                            end
                        end
                    end
                end
            end
        end
    end))
end

