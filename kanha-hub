    local antiVoidOn = false
    local comboKeys = {Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four}
    local function voidSelf(d)
        if antiBusy then return end
        local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") if not hrp then return end
        antiBusy = true local s = hrp.CFrame
        hrp.CFrame = CFrame.new(0,-500,0) task.wait(d or 1)
        if hrp and hrp.Parent then hrp.CFrame = s end antiBusy = false
    end
    local function hookAnti(c)
        task.wait(0.5)
        local hum = c:FindFirstChildOfClass("Humanoid")
        local anim = hum and hum:FindFirstChildOfClass("Animator")
        if anim then
            anim.AnimationPlayed:Connect(function(tr)
                if antiBusy then return end
                local n = tr.Animation and tr.Animation.Name or ""
                for sk, on in pairs(antiSkills) do if on and n:lower():find(sk:lower(), 1, true) then voidSelf(1.2) return end end
            end)
        end
    end
    if LP.Character then task.spawn(function() hookAnti(LP.Character) end) end
    LP.CharacterAdded:Connect(function(c) task.spawn(function() hookAnti(c) end) end)
    b.track("hbg_hp", RS.Heartbeat:Connect(function()
        if not antiVoidOn or not LP.Character then return end
