local function LoadArsenal(b)
    local RS, LP, P = b.RunService, b.LP, b.Players
    local aimOn, silentAimOn, triggerbotOn = false, false, false
    local aimFov = 150
    local espFolder = Instance.new("Folder", game.CoreGui) espFolder.Name = "KanhaARS_ESP"
    local espFlags = {player=false, health=false, distance=false}
    local espTick = 0
    local flyActive, noclipActive = false, false
    local trigCd = 0
    local function getClosest()
        local cam = workspace.CurrentCamera
        local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
        local closest, dist = nil, aimFov
        for _, p in ipairs(P:GetPlayers()) do
            if p ~= LP and p.Character then
                local head = p.Character:FindFirstChild("Head")
                if head then
                    local sp, onScreen = cam:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if d < dist then closest, dist = head, d end
                    end
                end
            end
        end
        return closest
    end
    local tab = b.Window:CreateTab("Arsenal", 4483362458)
    tab:CreateSlider({Name="Speed", Range={16,200}, Increment=1, CurrentValue=16, Callback=function(v) local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid") if h then h.WalkSpeed = v end end})
    tab:CreateSlider({Name="Jump", Range={50,200}, Increment=1, CurrentValue=50, Callback=function(v) local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid") if h then h.JumpPower = v end end})
    local flyBV
    tab:CreateToggle({Name="Fly", CurrentValue=false, Callback=function(s)
        flyActive = s b.untrack("ars_fly")
        if flyBV then flyBV:Destroy() flyBV = nil end
        if s then
            local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") if not hrp then return end
            flyBV = Instance.new("BodyVelocity", hrp) flyBV.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
            b.track("ars_fly", RS.RenderStepped:Connect(function()
                if not flyActive or not flyBV or not flyBV.Parent then return end
                local d = Vector3.new(0,0,0)
                if b.UIS:IsKeyDown(Enum.KeyCode.W) then d = d + workspace.CurrentCamera.CFrame.LookVector end
                if b.UIS:IsKeyDown(Enum.KeyCode.S) then d = d - workspace.CurrentCamera.CFrame.LookVector end
                if b.UIS:IsKeyDown(Enum.KeyCode.A) then d = d - workspace.CurrentCamera.CFrame.RightVector end
                if b.UIS:IsKeyDown(Enum.KeyCode.D) then d = d + workspace.CurrentCamera.CFrame.RightVector end
                if b.UIS:IsKeyDown(Enum.KeyCode.Space) then d = d + Vector3.new(0,1,0) end
                if b.UIS:IsKeyDown(Enum.KeyCode.LeftControl) then d = d - Vector3.new(0,1,0) end
                flyBV.Velocity = d * 55
            end))
        end
    end})
    tab:CreateToggle({Name="Noclip", CurrentValue=false, Callback=function(s) noclipActive = s end})
    b.track("ars_noclip", RS.Stepped:Connect(function()
        if noclipActive and LP.Character then for _, p in ipairs(LP.Character:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end end
    end))
    tab:CreateSection("Aimbot")
    tab:CreateSlider({Name="Aim FOV", Range={50,500}, Increment=1, CurrentValue=150, Callback=function(v) aimFov = v end})
    tab:CreateToggle({Name="Aim Assist", CurrentValue=false, Callback=function(s) aimOn = s if s then silentAimOn = false end end})
    tab:CreateToggle({Name="Silent Aim", CurrentValue=false, Callback=function(s) silentAimOn = s if s then aimOn = false end end})
    tab:CreateToggle({Name="Triggerbot", CurrentValue=false, Callback=function(s) triggerbotOn = s end})
    b.track("ars_aim", RS.RenderStepped:Connect(function()
        if not aimOn then return end
        local t = getClosest()
        if t then
            local cam = workspace.CurrentCamera
            cam.CFrame = CFrame.new(cam.CFrame.Position, t.Position)
        end
    end))
    b.track("ars_silent", RS.RenderStepped:Connect(function()
        if not silentAimOn or not LP.Character then return end
        local t = getClosest()
        if t then
            local tool = LP.Character:FindFirstChildWhichIsA("Tool")
            if tool and tool:FindFirstChild("Handle") then
                pcall(function() tool.Handle.CFrame = CFrame.new(tool.Handle.Position, t.Position) end)
            end
        end
    end))
    b.track("ars_trigger", RS.Heartbeat:Connect(function()
        if not triggerbotOn then return end
        if trigCd > 0 then trigCd = trigCd - 1 return end
        trigCd = 6
        local t = getClosest()
        if t then pcall(function() b.clickMouse(0.05) end) end
    end))
    tab:CreateSection("ESP")
    tab:CreateToggle({Name="Player ESP", CurrentValue=false, Callback=function(s) espFlags.player = s end})
    tab:CreateToggle({Name="Health Bar", CurrentValue=false, Callback=function(s) espFlags.health = s end})
    tab:CreateToggle({Name="Distance", CurrentValue=false, Callback=function(s) espFlags.distance = s end})
