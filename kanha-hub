        if noclipActive and LP.Character then for _, p in ipairs(LP.Character:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end end
    end))
    tab:CreateSection("Survival")
    tab:CreateToggle({Name="Godmode (LOCAL)", CurrentValue=false, Callback=function(s) godmodeOn = s end})
    b.track("mm2_god", RS.Heartbeat:Connect(function()
        if godmodeOn and LP.Character then
            local h = LP.Character:FindFirstChildOfClass("Humanoid")
            if h and h.Health < h.MaxHealth then h.Health = h.MaxHealth end
        end
    end))
    tab:CreateSection("Auto")
    tab:CreateToggle({Name="Coin Magnet", CurrentValue=false, Callback=function(s)
        coinMagnetOn = s
        if not s then for _, t in pairs(coinTweens) do pcall(function() t:Cancel() end) end coinTweens = {} end
    end})
    b.track("mm2_coin", RS.Heartbeat:Connect(function()
        if not coinMagnetOn or not LP.Character then return end
        local hrp = LP.Character:FindFirstChild("HumanoidRootPart") if not hrp then return end
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name:lower():find("coin") then
                if (obj.Position - hrp.Position).Magnitude < 60 then
                    if coinTweens[obj] then pcall(function() coinTweens[obj]:Cancel() end) end
                    local t = b.TweenService:Create(obj, TweenInfo.new(0.3), {CFrame = hrp.CFrame})
                    t:Play()
                    coinTweens[obj] = t
                end
            end
        end
    end))
    tab:CreateButton({Name="TP to Nearest Coin", Callback=function()
        local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") if not hrp then return end
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name:lower():find("coin") then hrp.CFrame = obj.CFrame + Vector3.new(0,3,0) break end
        end
    end})
    tab:CreateSection("Role ESP")
    tab:CreateToggle({Name="Murderer ESP (Red)", CurrentValue=false, Callback=function(s) espFlags.murderer = s end})
    tab:CreateToggle({Name="Sheriff ESP (Blue)", CurrentValue=false, Callback=function(s) espFlags.sheriff = s end})
    tab:CreateToggle({Name="Innocent ESP (Green)", CurrentValue=false, Callback=function(s) espFlags.innocent = s end})
