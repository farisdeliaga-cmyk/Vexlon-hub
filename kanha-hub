        local t = P:FindFirstChild(inputs.tp) if not t or not t.Character then return end
        local hrp = t.Character:FindFirstChild("HumanoidRootPart") local lhrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
