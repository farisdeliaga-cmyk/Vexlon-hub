    tab:CreateToggle({Name="Tracer", CurrentValue=false, Callback=function(s) tracerOn = s end})
    b.track("tsb_esp", RS.RenderStepped:Connect(function()
        if not (espOn or tracerOn) then return end
        espTick = espTick + 1
        if espTick % 20 ~= 0 then return end
        for _, v in ipairs(espFolder:GetChildren()) do v:Destroy() end
        local lhrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        for _, p in ipairs(P:GetPlayers()) do
            if p ~= LP and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    if espOn then
                        local bb = Instance.new("BillboardGui", espFolder) bb.Adornee = hrp bb.Size = UDim2.new(0,100,0,25) bb.AlwaysOnTop = true
