        local lhrp = LP.Character:FindFirstChild("HumanoidRootPart") if not lhrp then return end
        comboCd = comboCd - dt if comboCd > 0 then return end
        local nearest, nd = nil, 20
        for _, p in ipairs(P:GetPlayers()) do
            if p ~= LP and p.Character then
                local phrp = p.Character:FindFirstChild("HumanoidRootPart")
                if phrp then local d = (phrp.Position - lhrp.Position).Magnitude if d < nd then nearest = p nd = d end end
            end
        end
        if nearest then b.pressKey(comboKeys[comboIndex], 0.1) comboIndex = comboIndex + 1 if comboIndex > 4 then comboIndex = 1 end comboCd = 0.4 end
    end))
    b.track("tsb_block", RS.Heartbeat:Connect(function()
        if not autoBlockOn or not LP.Character then return end
        local lhrp = LP.Character:FindFirstChild("HumanoidRootPart") if not lhrp then return end
        for _, p in ipairs(P:GetPlayers()) do
            if p ~= LP and p.Character then
                local phrp = p.Character:FindFirstChild("HumanoidRootPart")
                if phrp and (phrp.Position - lhrp.Position).Magnitude <= 12 then pcall(function() b.pressKey(keybinds.block, 0.1) end) break end
            end
        end
    end))
    b.track("tsb_dodge", RS.Heartbeat:Connect(function()
        if not autoDodgeOn or not LP.Character then return end
        local lhrp = LP.Character:FindFirstChild("HumanoidRootPart") if not lhrp then return end
        for _, p in ipairs(P:GetPlayers()) do
            if p ~= LP and p.Character then
                local phrp = p.Character:FindFirstChild("HumanoidRootPart")
                if phrp and (phrp.Position - lhrp.Position).Magnitude <= 10 then pcall(function() b.pressKey(keybinds.dodge, 0.1) end) break end
            end
        end
