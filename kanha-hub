    local espTick = 0
    tab:CreateSection("ESP")
    for _, k in ipairs({"door","key","item","gold","locker","entity"}) do
        local kn = k:sub(1,1):upper()..k:sub(2)
        tab:CreateToggle({Name=kn.." ESP", CurrentValue=false, Callback=function(s) espFlags[k] = s end})
    end
    b.track("doors_esp", RS.RenderStepped:Connect(function()
        espTick = espTick + 1
        if espTick % 20 ~= 0 then return end
        for _, v in ipairs(espFolder:GetChildren()) do v:Destroy() end
        for _, obj in ipairs(workspace:GetDescendants()) do
            local n = obj.Name:lower() local key = nil
            if espFlags.entity and isEntity(obj.Name) then key = "entity"
            elseif espFlags.door and n:find("door") then key = "door"
            elseif espFlags.key and n:find("key") then key = "key"
            elseif espFlags.gold and n:find("gold") then key = "gold"
            elseif espFlags.locker and (n:find("locker") or n:find("closet")) then key = "locker"
            elseif espFlags.item and (n:find("drawer") or n:find("chest") or n:find("crucifix") or n:find("lighter") or n:find("flashlight") or n:find("bandage")) then key = "item" end
