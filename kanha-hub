        task.spawn(function()
            local km = {["1"]=Enum.KeyCode.One,["2"]=Enum.KeyCode.Two,["3"]=Enum.KeyCode.Three,["4"]=Enum.KeyCode.Four}
            for k in string.gmatch(inputs.combo, "[^,]+") do local kk = km[k:gsub("%s","")] if kk then b.pressKey(kk, 0.1) task.wait(0.35) end end
