local function LoadTSB(b)
    local RS, LP, P, UIS = b.RunService, b.LP, b.Players, b.UIS
    local antiSkills, antiBusy = {}, false
    local antiVoidActive, antiHitActive = false, false
    local flyActive, noclipActive = false, false
    local killAuraOn, autoComboOn, autoBlockOn, autoDodgeOn = false, false, false, false
    local killAuraRange, clickCd = 15, 0
    local keybinds = {grab=Enum.KeyCode.E, counter=Enum.KeyCode.F, uppercut=Enum.KeyCode.Space, block=Enum.KeyCode.F, dodge=Enum.KeyCode.Q, ult=Enum.KeyCode.G}
    local inputs = {fling="", tp="", combo="1,2,3,4"}
    local espFolder = Instance.new("Folder", game.CoreGui) espFolder.Name = "KanhaTSB_ESP"
    local espOn, tracerOn = false, false
    local espTick = 0
    local comboIndex, comboCd = 1, 0
    local comboKeys = {Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four}
    local function voidSelf(d)
        if antiBusy then return end
        local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") if not hrp then return end
        antiBusy = true local s = hrp.CFrame
        hrp.CFrame = CFrame.new(0,-500,0) task.wait(d or 1.2)
        if hrp and hrp.Parent then hrp.CFrame = s end antiBusy = false
    end
    local function fling(t)
        if not t or not t.Character then return end
        local h = t.Character:FindFirstChild("HumanoidRootPart") if not h then return end
        local bv = Instance.new("BodyVelocity", h)
        bv.Velocity = Vector3.new(math.random(-4000,4000), 8000, math.random(-4000,4000))
        bv.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
        game:GetService("Debris"):AddItem(bv, 0.8)
    end
    local function hookAnti(c)
        task.wait(0.5)
        local hum = c:FindFirstChildOfClass("Humanoid")
        local anim = hum and hum:FindFirstChildOfClass("Animator")
        if anim then
            anim.AnimationPlayed:Connect(function(tr)
                if antiBusy then return end
                local n = tr.Animation and tr.Animation.Name or ""
                for sk, on in pairs(antiSkills) do if on and n:lower():find(sk:lower(), 1, true) then voidSelf(1.2) return end end
            end)
        end
    end
    if LP.Character then task.spawn(function() hookAnti(LP.Character) end) end
    LP.CharacterAdded:Connect(function(c) task.spawn(function() hookAnti(c) end) end)
    b.track("tsb_hp", RS.Heartbeat:Connect(function()
        if not LP.Character then return end
        local h = LP.Character:FindFirstChildOfClass("Humanoid") if not h then return end
        if antiVoidActive and h.Health < h.MaxHealth then h.Health = h.MaxHealth end
        if antiHitActive and h.Health < h.MaxHealth and not antiBusy then voidSelf(1) end
    end))
    local tab = b.Window:CreateTab("TSB", 4483362458)
    tab:CreateSlider({Name="Speed", Range={16,500}, Increment=1, CurrentValue=16, Callback=function(v) local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid") if h then h.WalkSpeed = v end end})
    tab:CreateSlider({Name="Jump", Range={50,500}, Increment=1, CurrentValue=50, Callback=function(v) local h = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid") if h then h.JumpPower = v end end})
    local flyBV
    tab:CreateToggle({Name="Fly", CurrentValue=false, Callback=function(s)
        flyActive = s b.untrack("tsb_fly")
        if flyBV then flyBV:Destroy() flyBV = nil end
        if s then
            local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") if not hrp then return end
            flyBV = Instance.new("BodyVelocity", hrp) flyBV.Name = "KanhaFly"
            flyBV.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
            b.track("tsb_fly", RS.RenderStepped:Connect(function()
                if not flyActive or not flyBV or not flyBV.Parent then return end
                local d = Vector3.new(0,0,0)
                if UIS:IsKeyDown(Enum.KeyCode.W) then d = d + workspace.CurrentCamera.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.S) then d = d - workspace.CurrentCamera.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.A) then d = d - workspace.CurrentCamera.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.D) then d = d + workspace.CurrentCamera.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.Space) then d = d + Vector3.new(0,1,0) end
                if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then d = d - Vector3.new(0,1,0) end
                flyBV.Velocity = d * 60
            end))
        end
    end})
    tab:CreateToggle({Name="Noclip", CurrentValue=false, Callback=function(s) noclipActive = s end})
    b.track("tsb_noclip", RS.Stepped:Connect(function()
        if noclipActive and LP.Character then for _, p in ipairs(LP.Character:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end end
    end))
    tab:CreateSection("Combat")
    tab:CreateSlider({Name="Kill Aura Range", Range={5,50}, Increment=1, CurrentValue=15, Callback=function(v) killAuraRange = v end})
    tab:CreateToggle({Name="Kill Aura", CurrentValue=false, Callback=function(s) killAuraOn = s end})
    tab:CreateToggle({Name="Auto Combo", CurrentValue=false, Callback=function(s) autoComboOn = s end})
