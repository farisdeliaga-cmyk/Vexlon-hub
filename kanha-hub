        if s then b.track("session", b.RunService.Heartbeat:Connect(function()
            if not rotateOn then return end
            if (tick() - startTime) >= minutes * 60 then
                rotateOn = false
                b.notify("Session", "Sure doldu, rejoin...", 3)
                task.wait(2)
                pcall(function() b.TeleportService:Teleport(game.PlaceId, b.LP) end)
            end
        end)) end
    end})
    tab:CreateButton({Name="Elapsed Time", Callback=function()
        b.notify("Session", math.floor((tick() - startTime) / 60).." dakika gecti", 3)
    end})
end
