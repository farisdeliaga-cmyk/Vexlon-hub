    local espFlags = {murderer=false, sheriff=false, innocent=false, coin=false, gun=false, knife=false}
    local espColors = {murderer=Color3.new(1,0,0), sheriff=Color3.new(0,0.5,1), innocent=Color3.new(0,1,0), coin=Color3.new(1,1,0), gun=Color3.new(0.5,0,1), knife=Color3.new(1,0.5,0)}
    local espFolder = Instance.new("Folder", game.CoreGui) espFolder.Name = "KanhaMM2_ESP"
    local espTick = 0
    local coinMagnetOn = false
    local godmodeOn = false
    local roleCache = {}
    local coinTweens = {}
    local function getRole(p)
        local cached = roleCache[p]
        if cached and (tick() - cached.time) < 0.5 then return cached.role end
        local role = "Innocent"
        if p.Character then
            for _, tool in ipairs(p.Character:GetChildren()) do
                if tool:IsA("Tool") then
                    local n = tool.Name:lower()
                    if n:find("knife") then role = "Murderer" break end
                    if n:find("gun") or n:find("revolver") or n:find("pistol") then role = "Sheriff" break end
                end
            end
        end
        roleCache[p] = {role=role, time=tick()}
        return role
    end
