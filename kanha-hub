            b.track("hbg_fly", RS.RenderStepped:Connect(function()
                if not flyActive or not flyBV or not flyBV.Parent then return end
                local d = Vector3.new(0,0,0)
                if b.UIS:IsKeyDown(Enum.KeyCode.W) then d = d + workspace.CurrentCamera.CFrame.LookVector end
                if b.UIS:IsKeyDown(Enum.KeyCode.S) then d = d - workspace.CurrentCamera.CFrame.LookVector end
                if b.UIS:IsKeyDown(Enum.KeyCode.A) then d = d - workspace.CurrentCamera.CFrame.RightVector end
