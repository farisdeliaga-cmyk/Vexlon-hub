    tab:CreateButton({Name="Fling", Callback=function() local t = P:FindFirstChild(inputs.fling) if t then fling(t) end end})
    tab:CreateInput({Name="TP Target", PlaceholderText="Username", RemoveTextAfterFocusLost=false, Callback=function(v) inputs.tp = v end})
