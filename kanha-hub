                        local d = math.floor((hrp.Position - lhrp.Position).Magnitude)
                        local bb = Instance.new("BillboardGui", espFolder) bb.Adornee = hrp bb.Size = UDim2.new(0,80,0,20) bb.StudsOffset = Vector3.new(0,-3,0) bb.AlwaysOnTop = true
